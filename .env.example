# .env.example — copy to .env and populate before deploying
#
# The actual .env file must never be committed to version control.

# ── EMS (already present from the Fortinet install) ───────────────────────────
# POSTGRES_PASSWORD is set during EMS installation and already exists in
# /home/<user>/docker-compose.yaml's companion .env file. Do not remove it.
POSTGRES_PASSWORD=<your-postgres-password>

# ── Required additions for this project ───────────────────────────────────────

# Fully-qualified domain name of the EMS host.
# Used to construct the Grafana root URL for sub-path serving at /grafana/.
# Example: ems.example.com  (no https://, no trailing slash)
FQDN=<your-ems-fqdn>

# Grafana admin password. Replaces the default admin/admin credential.
# Generate a strong password: openssl rand -base64 24
GF_ADMIN_PASSWORD=<choose-a-strong-password>

# Redis authentication is already sourced from the EMS shared /db/.env on the
# host and does not need to be duplicated here for this project.
