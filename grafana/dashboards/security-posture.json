      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-fcm-default"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "sql": {
            "columns": [
              {
                "type": "function",
                "parameters": []
              }
            ],
            "groupBy": [
              {
                "type": "groupBy",
                "property": {
                  "type": "string"
                }
              }
            ],
            "limit": 50
          },
          "rawSql": "SELECT DATE_TRUNC('hour', ash.time) AS \"time\", COUNT(*) AS \"Scans\" FROM av_scan_history ash WHERE ash.vdom_id = 1 AND ash.time >= NOW() - INTERVAL '24 hours' GROUP BY DATE_TRUNC('hour', ash.time) ORDER BY \"time\";",
          "refId": "A"
        }
      ]
    },
