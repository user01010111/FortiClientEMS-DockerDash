          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(vd.cve_list,'VID '||cv.vulnerability_id::text) AS \"Vulnerability\",vd.release_date AS \"Published\",current_date-vd.release_date AS \"Days since publication\",COUNT(DISTINCT fu.client_id) AS \"Affected endpoints\" FROM client_vulnerabilities cv JOIN forticlients_users fu ON fu.id=cv.client_user_id AND fu.vdom_id=cv.vdom_id LEFT JOIN vuln_details vd ON vd.vid=cv.vulnerability_id AND vd.vdom_id=cv.vdom_id WHERE cv.vdom_id=1 AND cv.patch_status=0 GROUP BY cv.vulnerability_id,vd.cve_list,vd.release_date ORDER BY vd.release_date NULLS LAST LIMIT 50;"
        }
      ],
      "description": "Publication age is metadata age, not time exposed. Endpoints are deduplicated through the client-user relationship."
    }
  ]
}
