      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-fcm-default"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "sql": {
            "columns": [
              {
                "type": "function",
                "parameters": []
              }
            ],
            "groupBy": [
              {
                "type": "groupBy",
                "property": {
                  "type": "string"
                }
              }
            ],
            "limit": 50
          },
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE fu.av_protected = true) / NULLIF(COUNT(*), 0), 1) AS \"AV Protected %\" FROM forticlients_users fu WHERE fu.vdom_id = 1 AND fu.is_latest_user_for_fct = true;",
          "refId": "A"
        }
      ]
    },
