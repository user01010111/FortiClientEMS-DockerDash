            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-fcm-default"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "sql": {
            "columns": [
              {
                "type": "function",
                "parameters": []
              }
            ],
            "groupBy": [
              {
                "type": "groupBy",
                "property": {
                  "type": "string"
                }
              }
            ],
            "limit": 50
          },
          "rawSql": "SELECT COUNT(DISTINCT cv.vulnerability_id) FILTER (WHERE vs.severity = 'Critical') AS \"Critical\", COUNT(DISTINCT cv.vulnerability_id) FILTER (WHERE vs.severity = 'High') AS \"High\", COUNT(DISTINCT cv.vulnerability_id) FILTER (WHERE vs.severity = 'Medium') AS \"Medium\", COUNT(DISTINCT cv.vulnerability_id) FILTER (WHERE vs.severity = 'Low') AS \"Low\", COUNT(DISTINCT cv.vulnerability_id) FILTER (WHERE vs.severity IS NULL OR vs.severity NOT IN ('Critical', 'High', 'Medium', 'Low')) AS \"Unknown\" FROM client_vulnerabilities cv LEFT JOIN vuln_details vd ON vd.vid = cv.vulnerability_id AND vd.vdom_id = cv.vdom_id LEFT JOIN vuln_severity vs ON vs.id = vd.severity AND vs.vdom_id = cv.vdom_id WHERE cv.vdom_id = 1 AND cv.patch_status = 0;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
