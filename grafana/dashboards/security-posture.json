      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "CVSS"
          }
        ],
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-fcm-default"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "sql": {
            "columns": [
              {
                "type": "function",
                "parameters": []
              }
            ],
            "groupBy": [
              {
                "type": "groupBy",
                "property": {
                  "type": "string"
                }
              }
            ],
            "limit": 50
          },
          "rawSql": "SELECT COALESCE(vd.cve_list, CONCAT('VID ', cv.vulnerability_id::text)) AS \"CVEs\", COALESCE(vd.title, 'No vulnerability metadata present in vuln_details') AS \"Title\", COALESCE(vs.severity, 'Unknown') AS \"Severity\", ROUND(vd.cvss::numeric, 1) AS \"CVSS\", COUNT(DISTINCT fu.client_id) AS \"Affected Endpoints\" FROM client_vulnerabilities cv JOIN forticlients_users fu ON fu.id=cv.client_user_id AND fu.vdom_id=cv.vdom_id LEFT JOIN vuln_details vd ON vd.vid = cv.vulnerability_id AND vd.vdom_id = cv.vdom_id LEFT JOIN vuln_severity vs ON vs.id = vd.severity AND vs.vdom_id = cv.vdom_id WHERE cv.vdom_id = 1 AND cv.patch_status = 0 GROUP BY cv.vulnerability_id, vd.cve_list, vd.title, vs.severity, vd.cvss ORDER BY vd.cvss DESC NULLS LAST, \"Affected Endpoints\" DESC, cv.vulnerability_id LIMIT 50;",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AV Scans Completed (hourly)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
