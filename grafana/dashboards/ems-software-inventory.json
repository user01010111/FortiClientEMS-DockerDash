          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ems-fcm-default"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "sql": {
            "columns": [
              {
                "type": "function",
                "parameters": []
              }
            ],
            "groupBy": [
              {
                "type": "groupBy",
                "property": {
                  "type": "string"
                }
              }
            ],
            "limit": 50
          },
          "rawSql": "SELECT s.name AS \"Software\", COALESCE(NULLIF(s.vendor, ''), 'Unknown') AS \"Vendor\", COALESCE(NULLIF(s.version, ''), 'Unknown') AS \"Version\", COUNT(DISTINCT fu.client_id) AS \"Endpoints\" FROM client_software cs JOIN forticlients_users fu ON fu.id=cs.client_user_id AND fu.vdom_id=cs.vdom_id JOIN software s ON s.id = cs.software_id AND s.vdom_id = cs.vdom_id WHERE cs.vdom_id = 1 GROUP BY s.name, s.vendor, s.version ORDER BY \"Endpoints\" DESC LIMIT 100;",
          "refId": "A"
        }
      ],
      "description": "Distinct physical endpoints; multiple user reports on one machine count once."
    },
