          "refId": "A",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN EXISTS(SELECT 1 FROM dlp_agent WHERE vdom_id=1) THEN 'Agent reports present' ELSE 'No DLP agent reports' END AS \"Collection\";"
