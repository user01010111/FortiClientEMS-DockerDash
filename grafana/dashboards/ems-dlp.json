          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(nullif(region,''),'Unspecified') AS \"Region\",count(*) AS \"Connectors\",count(*) FILTER(WHERE nullif(btrim(error),'') IS NOT NULL) AS \"With errors\",count(*) FILTER(WHERE api_token_expiry <= now() AT TIME ZONE 'UTC') AS \"Expired credentials\" FROM dlp_connector WHERE vdom_id=1 GROUP BY 1;"
