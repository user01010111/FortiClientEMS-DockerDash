{
  "title": "EMS Stack Overview",
  "uid": "ems-stack-overview",
  "description": "High-level health for the EMS monitoring stack, ingress, probes, and busiest services.",
  "tags": ["ems", "stack", "prometheus", "overview"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose Project Regex",
        "type": "textbox",
        "query": "ems-.*",
        "current": { "text": "ems-.*", "value": "ems-.*" },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service Regex",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total EMS Containers",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "count(container_last_seen{container_label_com_docker_compose_project=~\"$project\", container_label_com_docker_compose_service!=\"\"})",
        "instant": true,
        "legendFormat": "",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Down Scrape Targets",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "count(up{job=~\"prometheus|node|cadvisor|loki|promtail|grafana|nginx|postgres|redis|pgbouncer|consul|blackbox-https|blackbox-http\"} == 0)",
        "instant": true,
        "legendFormat": "",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Container Restarts (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_project=~\"$project\", container_label_com_docker_compose_service!=\"\"}[24h]))",
        "instant": true,
        "legendFormat": "",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Probe Failures",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "count(probe_success{job=~\"blackbox-https|blackbox-http\"} == 0)",
        "instant": true,
        "legendFormat": "",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Nginx Requests per Second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "sum(rate(nginx_http_requests_total[5m]))",
        "legendFormat": "requests/s",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Top CPU Services",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "topk(8, sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=~\"$project\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}[5m])))",
        "legendFormat": "{{container_label_com_docker_compose_service}}",
        "refId": "A"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Top Memory Services",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "topk(8, sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"$project\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}))",
        "legendFormat": "{{container_label_com_docker_compose_service}}",
        "refId": "A"
      }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error Rate by Service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "ems-loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "ems-loki" },
        "expr": "sum by (service) (rate({project=~\"$project\"} |~ \"(?i)(error|exception|fatal|panic)\" [5m]))",
        "legendFormat": "{{service}}",
        "queryType": "range",
        "refId": "A"
      }]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Scrape Target Health",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": []
      },
      "options": {
        "sortBy": [{ "desc": false, "displayName": "Value" }],
        "footer": { "show": false }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "up{job=~\"prometheus|node|cadvisor|loki|promtail|grafana|nginx|postgres|redis|pgbouncer|consul|blackbox-https|blackbox-http\"}",
        "instant": true,
        "legendFormat": "",
        "refId": "A"
      }]
    }
  ]
}
