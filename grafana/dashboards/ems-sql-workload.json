      "id": 1,
      "type": "text",
      "title": "Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Database calls, execution time and I/O, with query profiles highlighting the busiest SQL workloads."
