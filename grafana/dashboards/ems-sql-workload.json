        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ems-prometheus"
          },
          "refId": "A",
          "expr": "ems_pg_features_statements_preloaded",
          "legendFormat": "",
