{
  "title": "EMS Containers",
  "uid": "ems-containers",
  "description": "Per-container resource usage, network, filesystem, and restart churn via cAdvisor.",
  "tags": ["ems", "containers", "cadvisor"],
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose Project Regex",
        "type": "textbox",
        "query": "ems-.*",
        "current": { "text": "ems-.*", "value": "ems-.*" },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service Regex",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU by Service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "cores" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "topk(8, sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=~\"$project\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}[5m])))", "legendFormat": "{{container_label_com_docker_compose_service}}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory by Service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "bytes" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "topk(8, sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=~\"$project\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}))", "legendFormat": "{{container_label_com_docker_compose_service}}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network Receive",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "Bps" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "topk(8, sum by (container_label_com_docker_compose_service) (rate(container_network_receive_bytes_total{container_label_com_docker_compose_project=~\"$project\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}[5m])))", "legendFormat": "{{container_label_com_docker_compose_service}}", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network Transmit",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "Bps" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "topk(8, sum by (container_label_com_docker_compose_service) (rate(container_network_transmit_bytes_total{container_label_com_docker_compose_project=~\"$project\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}[5m])))", "legendFormat": "{{container_label_com_docker_compose_service}}", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Restart Churn by Service (24h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "manual",
        "text": {},
        "valueMode": "color"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "topk(12, sum by (container_label_com_docker_compose_service) (changes(container_start_time_seconds{container_label_com_docker_compose_project=~\"$project\", container_label_com_docker_compose_service=~\"$service\", image!=\"\"}[24h])))",
        "instant": true,
        "legendFormat": "{{container_label_com_docker_compose_service}}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Filesystem Writes by Service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "manual",
        "text": {},
        "valueMode": "color"
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
        "expr": "topk(12, sum by (container_label_com_docker_compose_service) (rate(container_fs_writes_bytes_total{container_label_com_docker_compose_project=~\"$project\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}[5m])))",
        "instant": true,
        "legendFormat": "{{container_label_com_docker_compose_service}}",
        "refId": "A"
      }]
    }
  ]
}
