{
  "title": "EMS Operations",
  "uid": "ems-operations",
  "description": "Synthetic checks for public and internal endpoints plus log-derived operational signals.",
  "tags": ["ems", "operations", "blackbox", "loki"],
  "schemaVersion": 39,
  "version": 8,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "fiscalYearStartMonth": 0,
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose Project Regex",
        "type": "textbox",
        "query": "ems-.*",
        "current": { "text": "ems-.*", "value": "ems-.*" },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service Regex",
        "type": "textbox",
        "query": "deploy|webserver|nginx|ztna",
        "current": { "text": "deploy|webserver|nginx|ztna", "value": "deploy|webserver|nginx|ztna" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Public HTTPS Checks Passing",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "count(probe_success{job=\"blackbox-https\"} == 1)", "instant": true, "legendFormat": "", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Internal HTTP Checks Passing",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "count(probe_success{job=\"blackbox-http\"} == 1)", "instant": true, "legendFormat": "", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Deploy Health",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [{ "type": "value", "options": { "0": { "text": "Down" }, "1": { "text": "Up" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_success{job=\"blackbox-http\", instance=\"http://deploy:8010/\"}", "instant": true, "legendFormat": "", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Webserver Health",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [{ "type": "value", "options": { "0": { "text": "Down" }, "1": { "text": "Up" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "value", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_success{job=\"blackbox-http\", instance=\"http://webserver:8000/\"}", "instant": true, "legendFormat": "", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Probe Success",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "short" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_success{job=\"blackbox-https\", instance=\"https://nginx/\"}", "legendFormat": "Public Root", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_success{job=\"blackbox-https\", instance=\"https://nginx/grafana/login\"}", "legendFormat": "Grafana Login", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_success{job=\"blackbox-http\", instance=\"http://deploy:8010/\"}", "legendFormat": "Deploy API", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_success{job=\"blackbox-http\", instance=\"http://webserver:8000/\"}", "legendFormat": "Webserver", "refId": "D" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Probe Duration",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "s" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_duration_seconds{job=\"blackbox-https\", instance=\"https://nginx/\"}", "legendFormat": "Public Root", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_duration_seconds{job=\"blackbox-https\", instance=\"https://nginx/grafana/login\"}", "legendFormat": "Grafana Login", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_duration_seconds{job=\"blackbox-http\", instance=\"http://deploy:8010/\"}", "legendFormat": "Deploy API", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "ems-prometheus" }, "expr": "probe_duration_seconds{job=\"blackbox-http\", instance=\"http://webserver:8000/\"}", "legendFormat": "Webserver", "refId": "D" }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "HTTP Status Codes by Endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 400 }
            ]
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "manual",
        "text": {},
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
          "expr": "probe_http_status_code{job=\"blackbox-https\", instance=\"https://nginx/\"}",
          "instant": true,
          "legendFormat": "Public Root",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
          "expr": "probe_http_status_code{job=\"blackbox-https\", instance=\"https://nginx/grafana/login\"}",
          "instant": true,
          "legendFormat": "Grafana Login",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
          "expr": "probe_http_status_code{job=\"blackbox-http\", instance=\"http://deploy:8010/\"}",
          "instant": true,
          "legendFormat": "Deploy API",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "ems-prometheus" },
          "expr": "probe_http_status_code{job=\"blackbox-http\", instance=\"http://webserver:8000/\"}",
          "instant": true,
          "legendFormat": "Webserver",
          "refId": "D"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Operational Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "ems-loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "short" }, "overrides": [] },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] } },
      "targets": [{
        "datasource": { "type": "loki", "uid": "ems-loki" },
        "expr": "sum by (service) (rate({project=~\"$project\", service=~\"$service\"} |~ \"(?i)(error|exception|fatal|panic|timeout|failed)\" [5m]))",
        "legendFormat": "{{service}}",
        "queryType": "range",
        "refId": "A"
      }]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Live Operational Logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "ems-loki" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "ems-loki" },
        "expr": "{project=~\"$project\", service=~\"$service\"}",
        "legendFormat": "",
        "maxLines": 500,
        "refId": "A"
      }]
    }
  ]
}
